rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user can write their own doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Messages: only authenticated users can read/write
    match /messages/{messageId} {
      allow read: if request.auth != null;
      // Only the sender can create a message with their own uid
      allow create: if request.auth != null
        && request.resource.data.sender._id == request.auth.uid;
      // Only the sender can edit/delete (update isDeleted, content)
      allow update: if request.auth != null
        && resource.data.sender._id == request.auth.uid;
      allow delete: if false; // use soft-delete (isDeleted flag) instead
    }
  }
}
