rules_version = '2';
service cloud.firestore {
  match /databases/$(database)/documents {
    // All application data is restricted to Firebase accounts using @gmail.com.
    // The UI performs the same check before registration and sign-in.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@[gG][mM][aA][iI][lL]\\.com$');
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'armansomani786@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function isGroupAdmin(conversationId) {
      return isConversationMember(conversationId)
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds;
    }

    function canReceiveGroupInvite(targetUid) {
      let userPath = /databases/$(database)/documents/users/$(targetUid);
      return exists(userPath)
        && (
          !('privacy' in get(userPath).data)
          || !('whoCanAddToGroups' in get(userPath).data.privacy)
          || get(userPath).data.privacy.whoCanAddToGroups != 'nobody'
        );
    }

    function isBlockedBetweenMembers(conversationId) {
      let members = get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
      return members.size() == 2
        && (
          exists(/databases/$(database)/documents/users/$(members[0])/blocks/$(members[1]))
          || exists(/databases/$(database)/documents/users/$(members[1])/blocks/$(members[0]))
        );
    }

    function isAcceptedFriend(otherUid) {
      let outgoingRequest = /databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + otherUid);
      let incomingRequest = /databases/$(database)/documents/friendRequests/$(otherUid + '_' + request.auth.uid);
      return signedIn() && (
        (exists(outgoingRequest)
          && get(outgoingRequest).data.senderId == request.auth.uid
          && get(outgoingRequest).data.recipientId == otherUid
          && get(outgoingRequest).data.status == 'accepted')
        ||
        (exists(incomingRequest)
          && get(incomingRequest).data.senderId == otherUid
          && get(incomingRequest).data.recipientId == request.auth.uid
          && get(incomingRequest).data.status == 'accepted')
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['displayName', 'username', 'avatarId', 'createdAt', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['admin', 'verified', 'suspended']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'avatarId', 'bio', 'privacy', 'updatedAt'])
        && request.resource.data.username == resource.data.username
        && !request.resource.data.keys().hasAny(['admin', 'verified', 'suspended']);
      allow delete: if false;

      match /inbox/{conversationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid
          && isConversationMember(conversationId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if false;
      }

      match /blocks/{blockedUid} {
        // The account owner manages their block list; the blocked account may
        // check its own block status so the UI can disable messaging.
        allow get: if signedIn() && (request.auth.uid == uid || request.auth.uid == blockedUid);
        allow list: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == blockedUid
          && request.resource.data.username is string;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /contacts/{contactUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'requestId', 'createdAt'])
          && request.resource.data.uid == contactUid
          && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
          && (
            (
              getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == uid
              && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == contactUid
              && request.auth.uid in [uid, contactUid]
            )
            ||
            (
              getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == contactUid
              && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == uid
              && request.auth.uid in [uid, contactUid]
            )
          );
        allow update, delete: if false;
      }
    }

    match /friendRequests/{requestId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
          || resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && requestId == request.auth.uid + '_' + request.resource.data.recipientId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'status', 'createdAt'])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && (
          !('privacy' in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data)
          || !('discoverable' in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.privacy)
          || get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.privacy.discoverable != false
        )
        && (
          !('privacy' in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data)
          || !('whoCanMessage' in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.privacy)
          || get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.privacy.whoCanMessage != 'nobody'
        );
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && normalizedUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == normalizedUsername;
      // Claimed usernames are permanent; only a trusted admin migration may release one.
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Direct conversations require an accepted friendship. Group creation
      // is atomic with one membership record per invited accepted friend.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.keys().hasAll(['createdBy', 'memberIds', 'createdAt', 'updatedAt'])
        && (
          (
            !('type' in request.resource.data)
            && request.resource.data.memberIds.size() == 2
            && isAcceptedFriend(
              request.resource.data.memberIds[0] == request.auth.uid
                ? request.resource.data.memberIds[1]
                : request.resource.data.memberIds[0]
            )
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.memberIds.size() >= 2
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 48
            && request.resource.data.adminIds == [request.auth.uid]
            && request.resource.data.moderatorIds == []
            && request.resource.data.keys().hasOnly([
              'type', 'title', 'createdBy', 'memberIds', 'adminIds',
              'moderatorIds', 'createdAt', 'updatedAt'
            ])
          )
        );

      allow update: if isConversationMember(conversationId)
        && (
          (
            resource.data.type != 'group'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'photoURL', 'updatedAt', 'lastMessageAt', 'lastMessagePreview', 'lastMessageSenderId'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageSenderId'])
              || request.resource.data.lastMessageSenderId == request.auth.uid)
          )
          ||
          (
            resource.data.type == 'group'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'updatedAt', 'memberIds', 'adminIds', 'moderatorIds'])
            && (
              (
                request.auth.uid in resource.data.adminIds
                && (
                  (
                    request.resource.data.memberIds == resource.data.memberIds
                    && request.resource.data.adminIds == resource.data.adminIds
                    && request.resource.data.moderatorIds is list
                    && request.resource.data.moderatorIds.hasOnly(request.resource.data.memberIds)
                  )
                  ||
                  (
                    request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                    && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                    && request.resource.data.adminIds == resource.data.adminIds
                    && request.resource.data.moderatorIds == resource.data.moderatorIds
                  )
                  ||
                  (
                    !(request.auth.uid in request.resource.data.memberIds)
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() + 1 == resource.data.memberIds.size()
                    && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                    && request.resource.data.adminIds is list
                    && request.resource.data.adminIds.hasAll(resource.data.adminIds.removeAll([request.auth.uid]))
                    && request.resource.data.adminIds.size() >= resource.data.adminIds.size() - 1
                    && request.resource.data.adminIds.size() <= resource.data.adminIds.size()
                    && (request.resource.data.memberIds.size() == 0 || request.resource.data.adminIds.size() > 0)
                    && request.resource.data.adminIds.hasOnly(request.resource.data.memberIds)
                    && request.resource.data.moderatorIds is list
                    && request.resource.data.moderatorIds.hasOnly(request.resource.data.memberIds)
                  )
                )
              )
              ||
              (
                request.auth.uid in resource.data.memberIds
                && !(request.auth.uid in request.resource.data.memberIds)
                && request.resource.data.memberIds is list
                && request.resource.data.memberIds.size() + 1 == resource.data.memberIds.size()
                && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                && request.resource.data.adminIds == resource.data.adminIds
                && request.resource.data.moderatorIds is list
                && request.resource.data.moderatorIds.hasOnly(request.resource.data.memberIds)
              )
            )
          )
        );
      allow delete: if false;

      match /typing/{uid} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId)
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.isTyping is bool
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'isTyping', 'updatedAt']);
        allow delete: if isConversationMember(conversationId) && request.auth.uid == uid;
      }

      match /members/{uid} {
        allow read: if isConversationMember(conversationId);
        allow create: if signedIn()
          && existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds
          && uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'role', 'createdAt'])
          && (uid == request.auth.uid || (isAcceptedFriend(uid) && canReceiveGroupInvite(uid)));
        allow update: if signedIn()
          && isGroupAdmin(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'admin'
          && uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds
          && uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow delete: if signedIn()
          && isConversationMember(conversationId)
          && (request.auth.uid == uid || isGroupAdmin(conversationId));
      }

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);

        allow create: if isConversationMember(conversationId)
          && !isBlockedBetweenMembers(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'type', 'createdAt', 'readBy', 'reactions'])
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is list
          && request.resource.data.readBy == [request.auth.uid]
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() == 0
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000
            )
            ||
            (
              request.resource.data.type == 'image'
              && request.resource.data.viewOnce == true
              && request.resource.data.attachmentPath is string
              && request.resource.data.attachmentPath.size() > 0
              && request.resource.data.attachmentPath.size() <= 1024
            )
          )
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'createdAt', 'editedAt',
            'replyToId', 'replyToText', 'attachmentPath', 'viewOnce', 'expiresAt',
            'forwardedFrom', 'mentionIds', 'readBy', 'readAt', 'reactions'
          ]);

        allow update: if isConversationMember(conversationId)
          && (
            (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt', 'deletedAt'])
              && (
                (
                  resource.data.type == 'text'
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 5000
                  && request.resource.data.editedAt == request.time
                  && !('deletedAt' in request.resource.data)
                )
                ||
                (
                  request.resource.data.text == ''
                  && request.resource.data.deletedAt == request.time
                )
              )
            )
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readBy', 'readAt', 'expiresAt'])
              && request.resource.data.readBy is list
              && request.resource.data.readBy.hasAll(
                ('readBy' in resource.data && resource.data.readBy is list) ? resource.data.readBy : []
              )
              && request.auth.uid in request.resource.data.readBy
              && request.resource.data.readBy.size()
                <= (('readBy' in resource.data && resource.data.readBy is list) ? resource.data.readBy.size() : 0) + 1
              && resource.data.senderId != request.auth.uid
              && (
                !('readAt' in resource.data)
                  ? request.resource.data.readAt == request.time
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
                  : request.resource.data.readAt == resource.data.readAt
                    && (
                      'expiresAt' in resource.data
                        ? request.resource.data.expiresAt == resource.data.expiresAt
                        : request.resource.data.expiresAt == resource.data.readAt + duration.value(24, 'h')
                    )
              )
            )
            ||
            (
              resource.data.type == 'image'
              && resource.data.viewOnce == true
              && resource.data.senderId != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedByUids'])
              && request.resource.data.viewedByUids is list
              && request.resource.data.viewedByUids.hasAll(
                ('viewedByUids' in resource.data && resource.data.viewedByUids is list) ? resource.data.viewedByUids : []
              )
              && request.auth.uid in request.resource.data.viewedByUids
              && request.resource.data.viewedByUids.size()
                <= (('viewedByUids' in resource.data && resource.data.viewedByUids is list) ? resource.data.viewedByUids.size() : 0) + 1
            )
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions is map
              && request.resource.data.reactions.diff(
                ('reactions' in resource.data && resource.data.reactions is map) ? resource.data.reactions : {}
              ).affectedKeys().hasOnly([request.auth.uid])
              && (
                !(request.auth.uid in request.resource.data.reactions)
                || request.resource.data.reactions[request.auth.uid] in [
                  '👍', '❤️', '😂', '😮', '😢', '🙏', '🔥', '🎉',
                  '👏', '😍', '🤔', '🙌', '💯', '👎', '😡', '🤝'
                ]
              )
            )
          );

        allow delete: if false;

        match /views/{viewerUid} {
          allow get: if signedIn() && request.auth.uid == viewerUid;
          allow list: if false;
          allow create: if signedIn()
            && request.auth.uid == viewerUid
            && isConversationMember(conversationId)
            && get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data.type == 'image'
            && get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data.viewOnce == true
            && get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data.senderId != request.auth.uid
            && request.resource.data.viewerUid == viewerUid
            && request.resource.data.keys().hasOnly(['viewerUid', 'viewedAt'])
            && request.resource.data.viewedAt is timestamp
            && !exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)/views/$(viewerUid));
          allow update, delete: if false;
        }
      }

      match /polls/{pollId} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId);
        allow delete: if false;

        match /votes/{uid} {
          allow read: if isConversationMember(conversationId);
          allow create, update: if isConversationMember(conversationId)
            && request.auth.uid == uid;
          allow delete: if isConversationMember(conversationId)
            && request.auth.uid == uid;
        }
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
