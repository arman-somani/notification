rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@[gG][mM][aA][iI][lL]\\.com$');
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'armansomani786@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.admin == true;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function isAcceptedFriend(otherUid) {
      let outgoingRequest = /databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + otherUid);
      let incomingRequest = /databases/$(database)/documents/friendRequests/$(otherUid + '_' + request.auth.uid);
      return signedIn() && (
        (exists(outgoingRequest)
          && get(outgoingRequest).data.senderId == request.auth.uid
          && get(outgoingRequest).data.recipientId == otherUid
          && get(outgoingRequest).data.status == 'accepted')
        ||
        (exists(incomingRequest)
          && get(incomingRequest).data.senderId == otherUid
          && get(incomingRequest).data.recipientId == request.auth.uid
          && get(incomingRequest).data.status == 'accepted')
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['displayName', 'username', 'avatarId', 'createdAt', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['admin', 'verified', 'suspended']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'avatarId', 'bio', 'privacy', 'updatedAt'])
        && request.resource.data.username == resource.data.username
        && !request.resource.data.keys().hasAny(['admin', 'verified', 'suspended']);
      allow delete: if false;

      match /inbox/{conversationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid
          && isConversationMember(conversationId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if false;
      }

      match /blocks/{blockedUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /contacts/{contactUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'requestId', 'createdAt'])
          && request.resource.data.uid == contactUid
          && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
          && (
            (
              getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == uid
              && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == contactUid
              && request.auth.uid in [uid, contactUid]
            )
            ||
            (
              getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == contactUid
              && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == uid
              && request.auth.uid in [uid, contactUid]
            )
          );
        allow update, delete: if false;
      }
    }

    match /friendRequests/{requestId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
          || resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && requestId == request.auth.uid + '_' + request.resource.data.recipientId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'status', 'createdAt'])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && (
          !('privacy' in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data)
          || !('discoverable' in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.privacy)
          || get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.privacy.discoverable != false
        );
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && normalizedUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == normalizedUsername;
      // Claimed usernames are permanent; only a trusted admin migration may release one.
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.keys().hasAll(['createdBy', 'memberIds', 'createdAt', 'updatedAt'])
        && isAcceptedFriend(
          request.resource.data.memberIds[0] == request.auth.uid
            ? request.resource.data.memberIds[1]
            : request.resource.data.memberIds[0]
        );
      allow update: if isConversationMember(conversationId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'photoURL', 'updatedAt', 'lastMessageAt', 'lastMessagePreview']);
      allow delete: if false;

      match /members/{uid} {
        allow read, write: if false;
      }

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'type', 'createdAt'])
          && (
            request.resource.data.type != 'image'
            || (
              request.resource.data.viewOnce == true
              && request.resource.data.attachmentPath is string
              && request.resource.data.attachmentPath.size() > 0
              && request.resource.data.attachmentPath.size() <= 1024
            )
          )
          && (
            request.resource.data.type != 'audio'
            || (
              request.resource.data.attachmentPath is string
              && request.resource.data.attachmentPath.matches('^conversations/[^/]+/voice/[^/]+/[^/]+$')
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds > 0
              && request.resource.data.durationSeconds <= 300
              && request.resource.data.mimeType is string
              && request.resource.data.mimeType.matches('audio/(webm|ogg|mpeg|mp4|wav)')
            )
          )
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'createdAt', 'editedAt',
            'replyToId', 'replyToText', 'attachmentPath', 'viewOnce', 'expiresAt',
            'durationSeconds', 'mimeType', 'forwardedFrom', 'mentionIds'
          ]);
        allow update: if isConversationMember(conversationId)
          && (
            (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt', 'deletedAt'])
            )
            || (
              resource.data.type == 'image'
              && resource.data.viewOnce == true
              && resource.data.senderId != request.auth.uid
              && !('viewedByUid' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['viewedByUid', 'viewedAt'])
              && request.resource.data.viewedByUid == request.auth.uid
              && request.resource.data.viewedAt is timestamp
            )
          );
        allow delete: if false;
      }

      match /polls/{pollId} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId);
        allow delete: if false;

        match /votes/{uid} {
          allow read: if isConversationMember(conversationId);
          allow create, update: if isConversationMember(conversationId)
            && request.auth.uid == uid;
          allow delete: if isConversationMember(conversationId)
            && request.auth.uid == uid;
        }
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
})
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds > 0
              && request.resource.data.durationSeconds <= 300
              && request.resource.data.mimeType is string
              && request.resource.data.mimeType.matches('audio/(webm|ogg|mpeg|mp4|wav)')
            )
          )
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'createdAt', 'editedAt',
            'replyToId', 'replyToText', 'attachmentPath', 'viewOnce', 'expiresAt',
            'durationSeconds', 'mimeType', 'forwardedFrom', 'mentionIds'
          ]);
        allow update: if isConversationMember(conversationId)
          && (
            (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt', 'deletedAt'])
            )
            || (
              resource.data.type == 'image'
              && resource.data.viewOnce == true
              && resource.data.senderId != request.auth.uid
              && !('viewedByUid' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['viewedByUid', 'viewedAt'])
              && request.resource.data.viewedByUid == request.auth.uid
              && request.resource.data.viewedAt is timestamp
            )
          );
        allow delete: if false;
      }

      match /polls/{pollId} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId);
        allow delete: if false;

        match /votes/{uid} {
          allow read: if isConversationMember(conversationId);
          allow create, update: if isConversationMember(conversationId)
            && request.auth.uid == uid;
          allow delete: if isConversationMember(conversationId)
            && request.auth.uid == uid;
        }
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}