rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['admin', 'verified', 'suspended']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'username', 'avatarId', 'bio', 'privacy', 'updatedAt'])
        && !request.resource.data.keys().hasAny(['admin', 'verified', 'suspended']);
      allow delete: if false;

      match /inbox/{conversationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid
          && isConversationMember(conversationId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if false;
      }

      match /blocks/{blockedUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /usernames/{normalizedUsername} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember(conversationId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isConversationMember(conversationId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'photoURL', 'updatedAt', 'lastMessageAt', 'lastMessagePreview']);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isConversationMember(conversationId);
        allow create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'type', 'createdAt'])
          && (request.resource.data.type != 'image' || request.resource.data.viewOnce == true)
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'createdAt', 'editedAt',
            'replyToId', 'attachmentPath', 'viewOnce', 'expiresAt',
            'forwardedFrom', 'mentionIds'
          ]);
        allow update: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'editedAt', 'deletedAt']);
        allow delete: if false;
      }

      match /polls/{pollId} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId);
        allow delete: if false;

        match /votes/{uid} {
          allow read: if isConversationMember(conversationId);
          allow create, update: if isConversationMember(conversationId)
            && request.auth.uid == uid;
          allow delete: if isConversationMember(conversationId)
            && request.auth.uid == uid;
        }
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
