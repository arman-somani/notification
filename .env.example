# Copy to .env.local and fill these values from Firebase Console.
# Do not commit .env.local or service-account credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Cloudflare Worker API (public base URL; no trailing slash)
VITE_NOTIFICATION_API_URL=https://notification-api.mediatoolkit.workers.dev
