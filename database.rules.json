{
  "rules": {
    "friendships": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "presenceVisibility": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === 'everyone' || newData.val() === 'contacts' || newData.val() === 'nobody'"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('presenceVisibility').child($uid).val() !== 'nobody' && (root.child('presenceVisibility').child($uid).val() === 'everyone' || (root.child('friendships').child($uid).child(auth.uid).val() === true && root.child('friendships').child(auth.uid).child($uid).val() === true))))",
        "$connectionId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['state', 'lastChanged'])"
        }
      }
    }
  }
}
