{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        "$connectionId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['state', 'lastChanged'])"
        }
      }
    },
    "typing": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['isTyping', 'updatedAt'])"
        }
      }
    }
  }
}
